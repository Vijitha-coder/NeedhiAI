# Database - use sqlite for local dev, postgres for production
# Examples:
# DATABASE_URL=sqlite:///./needhiai.db
# DATABASE_URL=postgresql://user:password@localhost:5432/needhiai
DATABASE_URL=sqlite:///./needhiai.db

# JWT
JWT_SECRET=change-this-to-a-very-long-random-secret-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# LLM - optional, if not set app uses built-in rule-based analyzer
# For OpenAI compatible API:
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# For local fallback set to local_rule_based
LLM_PROVIDER=auto
# auto | openai | local_rule_based

# Embeddings
# Options: local_tfidf | sentence_transformer | openai
EMBEDDING_PROVIDER=local_tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector DB
VECTOR_DB_PATH=./chroma_data
VECTOR_DB_TYPE=chroma
# chroma | faiss | memory

# File Upload
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf,docx,jpg,jpeg,png

# App
APP_ENV=development
CORS_ORIGINS=*
