{
  "expo": {
    "name": "NeedhiAI",
    "slug": "needhiai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "needhiai",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1e3a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.needhiai.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1e3a"
      },
      "package": "com.needhiai.app"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NeedhiAI to access your photos to upload contracts",
          "cameraPermission": "Allow NeedhiAI to use camera to scan contracts"
        }
      ]
    ],
    "extra": {
      "backendUrl": "http://localhost:8000",
      "eas": {
        "projectId": "needhiai-legalisec"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
